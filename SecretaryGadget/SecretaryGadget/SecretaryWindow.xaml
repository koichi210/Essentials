<Window x:Class="SecretaryGadget.SecretaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="秘書さん"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        FontFamily="Yu Gothic UI, Meiryo UI"
        UseLayoutRounding="True">
    <Canvas x:Name="RootCanvas" ClipToBounds="True">
        <Image x:Name="CharacterImage"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               ToolTip="クリックで閉じます"
               Cursor="Hand"
               MouseLeftButtonUp="OnCharacterClick">
            <Image.RenderTransform>
                <TranslateTransform x:Name="CharacterShift" />
            </Image.RenderTransform>
        </Image>
        <Canvas x:Name="BubbleLayer" Opacity="0" IsHitTestVisible="False">
            <Border x:Name="Bubble"
                    Width="300"
                    Background="#FDFBF7"
                    BorderBrush="#2E3A59"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="14,10"
                    Cursor="Hand"
                    MouseEnter="OnBubbleMouseEnter"
                    MouseLeave="OnBubbleMouseLeave"
                    MouseLeftButtonUp="OnBubbleClick">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" />
                </Border.Effect>
                <StackPanel x:Name="BubbleContent">
                    <DockPanel LastChildFill="True">
                        <!-- 背景を透明で塗って余白を付け、×の線の隙間を押しても×として受ける(吹き出し本体のクリックにしない) -->
                        <TextBlock x:Name="CloseMark"
                                   DockPanel.Dock="Right"
                                   Text="×"
                                   FontSize="13"
                                   Foreground="#8A8F9C"
                                   Background="Transparent"
                                   Padding="6,3,6,3"
                                   Margin="2,-3,-6,0"
                                   VerticalAlignment="Top"
                                   Cursor="Arrow"
                                   MouseLeftButtonUp="OnCloseClick" />
                        <TextBlock x:Name="HeadlineText"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#30343F"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                    <Rectangle Height="1" Fill="#D8DCE6" Margin="0,6" />
                    <TextBlock x:Name="Line1Text"
                               FontSize="13"
                               Foreground="#30343F"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="19" />
                    <TextBlock x:Name="Line2Text"
                               FontSize="13"
                               Foreground="#30343F"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="19" />
                    <TextBlock x:Name="Line3Text"
                               FontSize="13"
                               Foreground="#30343F"
                               TextWrapping="Wrap"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="19"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="FooterText"
                               FontSize="11"
                               Foreground="#8A8F9C"
                               HorizontalAlignment="Right"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Path x:Name="Tail"
                  Data="M0,0 L16,10 L0,20"
                  Fill="#FDFBF7"
                  Stroke="#2E3A59"
                  StrokeThickness="1.5"
                  IsHitTestVisible="False" />
        </Canvas>
    </Canvas>
</Window>
