<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SecretaryGadget</RootNamespace>
    <AssemblyName>SecretaryGadget</AssemblyName>
    <ApplicationIcon>Assets\secretary.ico</ApplicationIcon>
    <!-- 仕様はnet9。.NET 9のDesktop Runtimeが無く10だけ入っているPCでも起動できるよう、上位メジャーへの繰り上げを許す -->
    <RollForward>Major</RollForward>
    <!-- 配布用のRelease\はビルド出力のコピー置き場なので、ソースとして拾わない -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Release\**</DefaultItemExcludes>
    <!-- ビルド出力を%LOCALAPPDATA%へ逃がしているため、exe/dll に埋め込まれるPDBの場所からユーザー名が見えないよう置き換える -->
    <PathMap>$(BaseIntermediateOutputPath)=obj\</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- スキンが1つも読めないときの既定絵・既定アイコン -->
    <Resource Include="Assets\secretary.png" />
    <Resource Include="Assets\secretary.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同梱スキン。original.png(切り抜き前の元絵)は配らない -->
    <None Update="Skins\**\secretary.png;Skins\**\icon.ico;Skins\**\skin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecretaryGadget.Tests" />
  </ItemGroup>

</Project>
